# Backend API
# Local example: http://192.168.1.X:8000
EXPO_PUBLIC_API_URL="https://seu-app-no-render.onrender.com"

# Legacy compatibility only while issue #8 replaces static API-key authorization
# with a verified per-user Supabase session. EXPO_PUBLIC_* values are embedded in
# the client application and MUST NOT contain service-role or other privileged secrets.
EXPO_PUBLIC_API_KEY="legacy-development-key-only"
