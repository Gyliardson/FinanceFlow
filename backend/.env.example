# Supabase
SUPABASE_URL=""
# Publishable/anon key. This is not an authorization boundary; user session + RLS are.
SUPABASE_KEY=""
# Server-only credential used for privileged private Storage administration.
# Never expose this value through EXPO_PUBLIC_*, mobile bundles, logs or fixtures.
SUPABASE_SERVICE_ROLE_KEY=""

# Google Gemini (server-only)
GEMINI_API_KEY=""

# Server
PORT=""
ENVIRONMENT="development"
# Comma-separated explicit browser origins, for example:
# CORS_ALLOWED_ORIGINS="https://app.example.com,https://admin.example.com"
# Production rejects wildcard origins and defaults to no browser origins when unset.
CORS_ALLOWED_ORIGINS=""

# Legacy direct-main development compatibility only. The production Docker
# composition root uses verified Supabase Bearer sessions and does not use this
# shared secret as an authorization boundary.
API_SECRET_KEY=""

# Scraping configuration (optional/local-only modules)
TARGET_CNPJ=""

# Unopar student portal credentials (optional/local-only)
UNOPAR_RA=""
UNOPAR_PASSWORD=""

# TIM mobile portal credentials (optional/local-only)
TIM_PHONE=""
TIM_PASSWORD=""

# IMAP integration credentials (optional/local-only)
GMAIL_EMAIL=""
GMAIL_APP_PASSWORD=""
