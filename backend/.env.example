# Supabase
SUPABASE_URL=""
# Publishable/anon key. This is not an authorization boundary; user session + RLS are.
SUPABASE_KEY=""
# Server-only credential used for privileged private Storage administration.
# Never expose this value through EXPO_PUBLIC_*, mobile bundles, logs or fixtures.
SUPABASE_SERVICE_ROLE_KEY=""

# Google Gemini (server-only)
GEMINI_API_KEY=""

# Server
PORT=""
ENVIRONMENT="development"
# Comma-separated explicit browser origins, for example:
# CORS_ALLOWED_ORIGINS="https://app.example.com,https://admin.example.com"
# Production rejects wildcard origins and defaults to no browser origins when unset.
CORS_ALLOWED_ORIGINS=""

# Legacy direct-main development compatibility only. The production Docker
# composition root uses verified Supabase Bearer sessions and does not use this
# shared secret as an authorization boundary.
API_SECRET_KEY=""

# -----------------------------------------------------------------------------
# Experimental external invoice integrations
# -----------------------------------------------------------------------------
# Disabled by default and not started by the production runtime. Set true only in
# a controlled local/experimental environment. Enabling does not authorize bypassing
# CAPTCHA, human verification, anti-fraud, paywalls or access controls.
ENABLE_EXPERIMENTAL_INTEGRATIONS="false"
# Collection-loop interval when the experimental scheduler is explicitly started.
# Allowed range: 300..86400 seconds. The scheduler does not persist financial rows.
EXPERIMENTAL_INTEGRATION_INTERVAL_SECONDS="86400"

# DASMEI browser adapter (experimental)
TARGET_CNPJ=""

# Unopar student portal adapter (experimental)
UNOPAR_RA=""
UNOPAR_PASSWORD=""

# TIM mobile portal adapter (experimental)
TIM_PHONE=""
TIM_PASSWORD=""

# IMAP/PDF collector (experimental)
IMAP_SERVER="imap.gmail.com"
GMAIL_EMAIL=""
GMAIL_APP_PASSWORD=""
# Required allowlist; comma-separated exact sender addresses.
IMAP_ALLOWED_SENDERS=""
# Optional comma-separated subject fragments. Empty means sender allowlist only.
IMAP_SUBJECT_CONTAINS=""
# Optional explicit password for encrypted invoice PDFs. Never derive it from CNPJ/PII.
IMAP_PDF_PASSWORD=""
